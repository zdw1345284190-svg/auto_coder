# ==============================================
# AutoCoder 环境变量配置模板
# 复制为 .env 后修改为本地实际配置
# ==============================================

# --------------------------
# 1. Claude Code CLI 配置
# --------------------------
# 本地Claude Code CLI可执行文件路径（默认直接调用命令）
CLAUDE_CODE_CLI_PATH=claude

# --------------------------
# 2. 本地LLM (llama.cpp) 配置
# --------------------------
# llama.cpp 服务接口地址（默认8080端口）
LLM_BASE_URL=http://localhost:8080/v1
# 本地LLM API密钥（本地部署无需修改）
LLM_API_KEY=dummy
# 本地运行的大模型名称
LLM_MODEL_NAME=qwen3.6

# --------------------------
# 3. 搜索服务 (SearXNG) 配置
# --------------------------
# SearXNG 本地搜索服务地址（默认8888端口）
SEARXNG_BASE_URL=http://localhost:8888

# --------------------------
# 4. 任务执行核心配置
# --------------------------
# 单任务最大上下文token限制（固定200万，请勿随意修改）
MAX_CONTEXT_LENGTH=2000000
# 任务失败自动重试最大次数
MAX_RETRIES=3
# 单任务执行超时时间（单位：秒，3600=1小时）
TASK_TIMEOUT=3600

# --------------------------
# 5. 日志系统配置
# --------------------------
# 日志级别：DEBUG(详细) / INFO(标准) / WARNING(警告) / ERROR(错误)
LOG_LEVEL=DEBUG
# 日志输出格式（标准时间+模块+级别+信息）
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# --------------------------
# 6. AI代理温度配置
# 取值范围 0.0 ~ 1.0：越低结果越严谨/固定，越高越灵活/创意
# --------------------------
# 开发代理温度
DEVELOPER_TEMPERATURE=0.2
# 测试代理温度（建议更低，保证测试严格性）
TESTER_TEMPERATURE=0.1
# 单任务测试失败后，最大自动修复迭代次数（开发+复测）
MAX_FIX_ITER=5