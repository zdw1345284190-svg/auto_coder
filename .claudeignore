# Claude Code 忽略规则
# 基于 .gitignore 生成，用于限制 Claude Code 遍历和读取文件的范围

# 虚拟环境
.venv/
venv/
ENV/

# 日志文件
logs/
*.log

# 项目文件（子项目由 --project 指定，无需遍历）
project/*
docx/*

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo
